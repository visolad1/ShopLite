<?xml version="1.0" encoding="utf-8" ?>
<!--
    Reusable loading / error / empty state.
    Priority: loading > error (with Retry) > empty (with optional action).
-->
<ContentView
    x:Class="Ecommerce.Mobile.Components.StateView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:Ecommerce.Mobile.Components"
    xmlns:icons="clr-namespace:Ecommerce.Mobile.Resources.Styles">

    <Grid x:Name="Root" x:DataType="components:StateView" Padding="32,48" VerticalOptions="Center">

        <!-- Loading -->
        <VerticalStackLayout IsVisible="{Binding ShowLoading}" Spacing="12" HorizontalOptions="Center">
            <ActivityIndicator IsRunning="{Binding ShowLoading}" WidthRequest="36" HeightRequest="36" />
            <Label Text="{Binding LoadingText}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Error -->
        <VerticalStackLayout IsVisible="{Binding ShowError}" Spacing="10" HorizontalOptions="Center">
            <Label Text="{x:Static icons:Icons.WifiOff}"
                   Style="{StaticResource Icon}" FontSize="48"
                   TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
            <Label Text="Something went wrong" Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" />
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
            <Button Text="Try again" Command="{Binding RetryCommand}" Style="{StaticResource SecondaryButton}"
                    HorizontalOptions="Center" Margin="0,8,0,0" WidthRequest="160" />
        </VerticalStackLayout>

        <!-- Empty -->
        <VerticalStackLayout IsVisible="{Binding ShowEmpty}" Spacing="10" HorizontalOptions="Center">
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoft}, Dark={StaticResource PrimarySoftDark}}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 40" WidthRequest="80" HeightRequest="80" HorizontalOptions="Center">
                <Label Text="{Binding EmptyIcon}" Style="{StaticResource Icon}" FontSize="38"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            </Border>
            <Label Text="{Binding EmptyTitle}" Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" Margin="0,6,0,0" />
            <Label Text="{Binding EmptyMessage}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
            <Button Text="{Binding ActionText}" Command="{Binding ActionCommand}"
                    IsVisible="{Binding HasAction}" HorizontalOptions="Center" Margin="0,8,0,0" WidthRequest="200" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
