<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!-- Design tokens: colors (light/dark pairs), spacing and radii. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand -->
    <Color x:Key="Primary">#4F46E5</Color>
    <Color x:Key="PrimaryDark">#818CF8</Color>
    <Color x:Key="PrimarySoft">#EEF2FF</Color>
    <Color x:Key="PrimarySoftDark">#272A4A</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>

    <!-- Surfaces -->
    <Color x:Key="PageBackground">#F6F7F9</Color>
    <Color x:Key="PageBackgroundDark">#0E1014</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1A1D23</Color>
    <Color x:Key="SurfaceMuted">#F1F2F5</Color>
    <Color x:Key="SurfaceMutedDark">#242830</Color>
    <Color x:Key="Stroke">#E5E7EB</Color>
    <Color x:Key="StrokeDark">#2C3038</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#111827</Color>
    <Color x:Key="TextPrimaryDark">#F3F4F6</Color>
    <Color x:Key="TextSecondary">#6B7280</Color>
    <Color x:Key="TextSecondaryDark">#9CA3AF</Color>

    <!-- Status -->
    <Color x:Key="Success">#16A34A</Color>
    <Color x:Key="SuccessDark">#4ADE80</Color>
    <Color x:Key="Warning">#D97706</Color>
    <Color x:Key="WarningDark">#FBBF24</Color>
    <Color x:Key="Danger">#DC2626</Color>
    <Color x:Key="DangerDark">#F87171</Color>
    <Color x:Key="Disabled">#C7CAD1</Color>
    <Color x:Key="DisabledDark">#3A3F48</Color>

    <!-- Spacing scale -->
    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">12</x:Double>
    <x:Double x:Key="SpaceL">16</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>
    <Thickness x:Key="PagePadding">16</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>

    <!-- Radii -->
    <x:Double x:Key="RadiusM">12</x:Double>
    <x:Double x:Key="RadiusL">16</x:Double>

</ResourceDictionary>
