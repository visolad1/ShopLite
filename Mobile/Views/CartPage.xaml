<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="Ecommerce.Mobile.Views.CartPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Ecommerce.Mobile.Views"
    xmlns:vm="clr-namespace:Ecommerce.Mobile.ViewModels"
    xmlns:models="clr-namespace:Ecommerce.Mobile.Models"
    xmlns:components="clr-namespace:Ecommerce.Mobile.Components"
    xmlns:icons="clr-namespace:Ecommerce.Mobile.Resources.Styles"
    x:DataType="vm:CartViewModel"
    Title="My cart">

    <Grid RowDefinitions="*,Auto">
        <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Lines}" SelectionMode="None" Margin="16,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.Header>
                    <BoxView HeightRequest="8" Color="Transparent" />
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CartLine">
                        <Border Style="{StaticResource Card}" Padding="12">
                            <Grid ColumnDefinitions="76,*,Auto" ColumnSpacing="12">
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" WidthRequest="76" HeightRequest="76"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark={StaticResource SurfaceMutedDark}}">
                                    <Image Source="{Binding ThumbnailUrl}" Aspect="AspectFill" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding ProductName}" Style="{StaticResource Subtitle}" FontSize="14" MaxLines="2" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding UnitPrice, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource Caption}" />
                                    <HorizontalStackLayout Spacing="10" Margin="0,6,0,0">
                                        <Button Text="{x:Static icons:Icons.Remove}" Style="{StaticResource StepperButton}" WidthRequest="32" HeightRequest="32"
                                                Command="{Binding DecreaseCommand, Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}, x:DataType=vm:CartViewModel}"
                                                CommandParameter="{Binding .}" />
                                        <Label Text="{Binding Quantity}" FontFamily="OpenSansSemibold" FontSize="15" MinimumWidthRequest="20"
                                               HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                        <Button Text="{x:Static icons:Icons.Add}" Style="{StaticResource StepperButton}" WidthRequest="32" HeightRequest="32"
                                                IsEnabled="{Binding CanIncrease}"
                                                Command="{Binding IncreaseCommand, Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}, x:DataType=vm:CartViewModel}"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Grid Grid.Column="2" RowDefinitions="Auto,*">
                                    <Button Text="{x:Static icons:Icons.Delete}" FontFamily="MaterialIcons" FontSize="22" BackgroundColor="Transparent"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                            WidthRequest="40" HeightRequest="40" Padding="0" HorizontalOptions="End"
                                            Command="{Binding RemoveCommand, Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}, x:DataType=vm:CartViewModel}"
                                            CommandParameter="{Binding .}" />
                                    <Label Grid.Row="1" Text="{Binding LineTotal, Converter={StaticResource CurrencyConverter}}"
                                           Style="{StaticResource Subtitle}" VerticalOptions="End" HorizontalOptions="End" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <components:StateView IsLoading="{Binding IsBusy}" ErrorMessage="{Binding ErrorMessage}" RetryCommand="{Binding RetryCommand}"
                                          IsEmpty="{Binding IsEmpty}" EmptyIcon="{x:Static icons:Icons.ShoppingCart}"
                                          EmptyTitle="Your cart is empty" EmptyMessage="Looks like you haven't added anything yet."
                                          ActionText="Start shopping" ActionCommand="{Binding StartShoppingCommand}" />
                </CollectionView.EmptyView>
                <CollectionView.Footer>
                    <BoxView HeightRequest="16" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <!-- Summary / checkout bar -->
        <Border Grid.Row="1" IsVisible="{Binding HasItems}" StrokeThickness="0" Padding="16,14,16,16"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label Text="Total" Style="{StaticResource Caption}" />
                        <Label Text="{Binding TotalQuantity, StringFormat='{0} item(s)'}" Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" AutomationId="CartTotal" Text="{Binding Total, Converter={StaticResource CurrencyConverter}}"
                           Style="{StaticResource Title}" VerticalOptions="Center" />
                </Grid>
                <Button AutomationId="CheckoutButton" Text="Checkout" Command="{Binding CheckoutCommand}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</views:BasePage>
