<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android builds everywhere; iOS is added on macOS (requires Xcode to actually build). -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Ecommerce.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Generate C# from XAML at compile time (compiled bindings everywhere via x:DataType). -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>ShopLite</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.example.shoplite</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!-- iOS: keychain entitlement is required for SecureStorage (token storage) on the simulator. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<CodesignEntitlements>Platforms\iOS\Entitlements.plist</CodesignEntitlements>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#4F46E5" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#4F46E5" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- Environment-specific API settings: appsettings.json is always embedded and
	     appsettings.{ApiEnvironment}.json is layered on top when present.
	     ApiEnvironment defaults to the build configuration (Debug/Release); override it with
	     e.g. `-p:ApiEnvironment=Development` to point a Release build at the local dev API. -->
	<PropertyGroup>
		<ApiEnvironment Condition="'$(ApiEnvironment)' == ''">$(Configuration)</ApiEnvironment>
	</PropertyGroup>
	<ItemGroup>
		<EmbeddedResource Include="appsettings.json" LogicalName="appsettings.json" />
		<EmbeddedResource Include="appsettings.$(ApiEnvironment).json" LogicalName="appsettings.environment.json" Condition="Exists('appsettings.$(ApiEnvironment).json')" />
		<None Remove="appsettings*.json" />
		<Content Remove="appsettings*.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.130" />
		<PackageReference Include="CommunityToolkit.Maui" Version="16.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

</Project>
