<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="Ecommerce.Mobile.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Ecommerce.Mobile.Views"
    xmlns:vm="clr-namespace:Ecommerce.Mobile.ViewModels"
    xmlns:icons="clr-namespace:Ecommerce.Mobile.Resources.Styles"
    x:DataType="vm:ProfileViewModel"
    Title="Profile">

    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,24" Spacing="16">

            <!-- User card -->
            <Border Style="{StaticResource Card}" Padding="20">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoft}, Dark={StaticResource PrimarySoftDark}}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 32" WidthRequest="64" HeightRequest="64">
                        <Label Text="{Binding Initials}" FontFamily="OpenSansSemibold" FontSize="22"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding FullName}" Style="{StaticResource Title}" FontSize="18" />
                        <Label Text="{Binding Email}" Style="{StaticResource Caption}" FontSize="14" />
                        <Label Text="{Binding MemberSince}" Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Menu -->
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="16,14">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ViewOrdersCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="{x:Static icons:Icons.ReceiptLong}" Style="{StaticResource Icon}"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="My orders" Style="{StaticResource Subtitle}" />
                        <Label Text="Track and review your order history" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{x:Static icons:Icons.ChevronRight}" Style="{StaticResource SecondaryIcon}" />
                </Grid>
            </Border>

            <Button AutomationId="LogoutButton" Text="Log out" Command="{Binding LogoutCommand}" Style="{StaticResource DangerButton}" />

            <VerticalStackLayout Spacing="2" Margin="0,8,0,0">
                <Label Text="{Binding AppVersion}" Style="{StaticResource Caption}" FontSize="12" HorizontalTextAlignment="Center" />
                <Label Text="{Binding ServerInfo}" Style="{StaticResource Caption}" FontSize="12" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
