# Copy to `.env` and replace the values. Never commit the real `.env` file.

# PostgreSQL
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me-strong-db-password
# Host port for PostgreSQL (container always listens on 5432)
POSTGRES_PORT=5433

# API
API_PORT=5080
ASPNETCORE_ENVIRONMENT=Production
SWAGGER_ENABLED=true

# JWT – use a long random value, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=ecommerce-api
JWT_AUDIENCE=ecommerce-mobile
JWT_EXPIRY_MINUTES=10080
