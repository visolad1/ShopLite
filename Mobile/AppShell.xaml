<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Ecommerce.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Ecommerce.Mobile.Views"
    xmlns:icons="clr-namespace:Ecommerce.Mobile.Resources.Styles"
    Shell.FlyoutBehavior="Disabled"
    Title="ShopLite">

    <!-- Startup: restores the saved session, then routes to //home or //login -->
    <ShellContent Route="startup" ContentTemplate="{DataTemplate views:StartupPage}" />

    <ShellContent Route="login" ContentTemplate="{DataTemplate views:LoginPage}" />

    <!-- Main app with bottom navigation -->
    <TabBar Route="main">
        <Tab Title="Home" Route="home">
            <Tab.Icon>
                <FontImageSource FontFamily="MaterialIcons" Glyph="{x:Static icons:Icons.Home}" Size="24" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
        </Tab>
        <Tab Title="Shop" Route="catalog">
            <Tab.Icon>
                <FontImageSource FontFamily="MaterialIcons" Glyph="{x:Static icons:Icons.Storefront}" Size="24" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:CatalogPage}" />
        </Tab>
        <Tab Title="Cart" Route="cart">
            <Tab.Icon>
                <FontImageSource FontFamily="MaterialIcons" Glyph="{x:Static icons:Icons.ShoppingCart}" Size="24" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:CartPage}" />
        </Tab>
        <Tab Title="Orders" Route="orders">
            <Tab.Icon>
                <FontImageSource FontFamily="MaterialIcons" Glyph="{x:Static icons:Icons.ReceiptLong}" Size="24" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:OrdersPage}" />
        </Tab>
        <Tab Title="Profile" Route="profile">
            <Tab.Icon>
                <FontImageSource FontFamily="MaterialIcons" Glyph="{x:Static icons:Icons.Person}" Size="24" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:ProfilePage}" />
        </Tab>
    </TabBar>
</Shell>
